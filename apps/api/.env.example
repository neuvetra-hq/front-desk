# Copy this file to .env.local and fill in the values
# Never commit .env.local to git

PORT=3000

# Supabase
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://api.neuvetra.com
TWILIO_MESSAGE_SERVICE_SID=

# Retell AI
RETELL_API_KEY=
RETELL_AGENT_ID=

# Cal.com (self-hosted at cal.neuvetra.com)
CALCOM_API_URL=https://cal.neuvetra.com/api/v2
CALCOM_API_KEY=cal_

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_METER_EVENT_NAME=front_desk_minutes
STRIPE_PRICE_STARTER_FLAT=price_...
STRIPE_PRICE_STARTER_METERED=price_...
STRIPE_PRICE_GROWTH_FLAT=price_...
STRIPE_PRICE_GROWTH_METERED=price_...
STRIPE_PRICE_PRO_FLAT=price_...
STRIPE_PRICE_PRO_METERED=price_...
